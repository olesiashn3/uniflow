# Copy to .env for local (non-Docker) development:
#   copy .env.example .env   (Windows)
#   cp .env.example .env     (Linux / macOS)

SECRET_KEY=change-me-in-production
DATABASE_URL=mysql+pymysql://root:root@localhost/uniflow_db
AUTO_CREATE_TABLES=1

# Docker Compose sets DATABASE_URL automatically (host db:3306).
# Local MySQL on the default port; Docker maps db to localhost:3307 if you use compose.
